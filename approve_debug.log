2026-06-01T19:24:07+08:00 SQL=SELECT r.reservation_id, r.`user_id` AS applicant_user_id, r.submitted_at AS submitted_at, r.borrow_start_at, r.borrow_end_at, u.full_name, u.email
             FROM reservations r
             JOIN users u ON r.`user_id` = u.user_id
             WHERE r.approval_status = 'pending'  AND r.approval_stage IN ('a')
             ORDER BY r.submitted_at ASC
             LIMIT 200 rows=2
